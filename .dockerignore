backend/data
backend/cache
backend/log
backend/internal/webui/dist
backend/cmd/decodetest
backend/cmd/dumpdb
**/*.exe
**/*.test
**/*.out

# Docs / test fixtures not needed at build time
.testdata
*.md
LICENSE

