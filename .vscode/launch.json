{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: zreader",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend/cmd/zreader",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "ZREADER_PORT": "8080",
        "ZREADER_DATA_DIR": "${workspaceFolder}/backend/data",
        "ZREADER_LIBRARY_PATH": "${workspaceFolder}/books"
      },
      "showLog": true
    },
    {
      "name": "Backend: test (library)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/backend/internal/library",
      "cwd": "${workspaceFolder}/backend",
      "args": ["-test.v"]
    },
    {
      "name": "Backend: test (current file)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "cwd": "${workspaceFolder}/backend",
      "args": ["-test.v", "-test.run", "${selectedText}"]
    },
    {
      "name": "Frontend: Vite + Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "vite: dev",
      "postDebugTask": "vite: stop"
    },
    {
      "name": "Frontend: Vite + Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "vite: dev",
      "postDebugTask": "vite: stop"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (Backend + Vite + Edge)",
      "configurations": ["Backend: zreader", "Frontend: Vite + Edge"],
      "stopAll": true
    }
  ]
}
