# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDE
.idea/
.claude/
*.swp
*~

# Logs
*.log
logs/

# Node
node_modules/
.pnpm-store/
.npm/
*.tsbuildinfo

# Frontend build output (rebuilt on every `pnpm build`)
frontend/dist/

# Go
*.exe
*.test
*.out
vendor/

# Backend runtime artefacts
backend/data/
backend/cache/
backend/log/

# Host-side docker-compose mount points — local library + sqlite runtime.
/books/
/data/
# Embedded SPA target. Built on demand; never committed.
backend/internal/webui/dist/*
!backend/internal/webui/dist/.gitkeep

# Local secrets
.env
.env.*
!.env.example

# Local sandbox for end-to-end backend tests
.testdata/

# Private corpus config for TestFormatToCache_Corpus — references real
# book paths/titles and stays out of the repo. corpus.example.json
# (the schema template) is committed.
backend/internal/library/testdata/corpus.json

# Stray API-response dumps from manual curl debugging.
.tmp_*.json

# Frontend uses pnpm; npm's lockfile only shows up if someone runs
# `npm install` by accident — never commit it.
frontend/package-lock.json
